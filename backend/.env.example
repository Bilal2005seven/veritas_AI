# VeritasAI V1 — Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Example: ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── NLP / Transformer ────────────────────────────────────────────────────────
# HuggingFace model id for NLI / stance detection.
TRANSFORMER_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# ── Embedding / RAG ──────────────────────────────────────────────────────────
# HuggingFace model id for sentence embeddings.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Local path where the FAISS index will be stored.
VECTOR_STORE_PATH=./data/vector_store

# ── Web Search ───────────────────────────────────────────────────────────────
# API key for Serper (https://serper.dev) or your chosen search provider.
SERPER_API_KEY=your_serper_api_key_here
WEB_SEARCH_MAX_RESULTS=10

# ── Knowledge Graph ──────────────────────────────────────────────────────────
# Neo4j connection details (leave blank until graph_engine is implemented).
GRAPH_DB_URI=bolt://localhost:7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=your_graph_password_here

# ── Credibility Thresholds ───────────────────────────────────────────────────
CREDIBILITY_THRESHOLD_VERIFIED=0.75
CREDIBILITY_THRESHOLD_CONTRADICTED=0.35
